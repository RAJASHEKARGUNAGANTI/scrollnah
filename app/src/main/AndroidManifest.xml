<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Lets us read how long each app was used. The user grants it in
         Settings > Usage access (it can't be asked for with a normal popup). -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Step 4: background blocker -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Chill-mode nudges (asked for at runtime on Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- "Display over other apps": lets the Pause screen open on top of another app -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Restart the blocker after a reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Android 11+ hides other apps by default. This lets us list apps that have
         a launcher icon (for the "Add an app" picker and app names). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".UnscrollApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Unscroll"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Unscroll.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Full-screen Pause screen. Own task + hidden from Recents so it sits on top
             of the blocked app and can't be swiped back to. -->
        <activity
            android:name=".PauseActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.unscroll.app.pause"
            android:theme="@style/Theme.Unscroll" />

        <!-- "Take a break" on a break reminder: invisible, records the choice and goes home. -->
        <activity
            android:name=".BreakActionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="com.unscroll.app.breaks"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Checks every second which app is open (see BlockerService). -->
        <service
            android:name=".service.BlockerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Digital wellbeing: checks which app is open so it can pause apps the user chose to limit and remind them to take breaks." />
        </service>

        <!-- "Focus" tile for the swipe-down Quick Settings panel (focus for 30 minutes). -->
        <service
            android:name=".service.FocusTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_focus"
            android:label="Focus"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <!-- An on/off tile (no ">" arrow; TalkBack says "switch"). -->
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!-- Home-screen widgets (plain RemoteViews, see widget/MascotWidgets.kt): medium 4x2, animated mascot 2x2 and small 2x2. The medium one keeps
             the old receiver name so widgets placed before still work. -->
        <receiver
            android:name=".widget.BlobbyWidget"
            android:exported="true"
            android:label="Mascot mood">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/blobby_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.MascotOnlyWidgetReceiver"
            android:exported="true"
            android:label="Mascot (animated)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/mascot_only_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.SmallMascotWidgetReceiver"
            android:exported="true"
            android:label="Mascot mood (small)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/mascot_small_widget_info" />
        </receiver>

        <receiver
            android:name=".service.NudgeReceiver"
            android:exported="false" />

        <receiver
            android:name=".service.BreakSnoozeReceiver"
            android:exported="false" />

        <!-- "Turn off tracker" button on the payment-app notification. -->
        <receiver
            android:name=".service.TrackerOffReceiver"
            android:exported="false" />

        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Opt-in watcher for Instagram Reels / YouTube Shorts (see FeatureWatchService). -->
        <service
            android:name=".service.FeatureWatchService"
            android:exported="false"
            android:label="ScrollNah Reels &amp; Shorts tracker"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/feature_watch_service" />
        </service>
    </application>

</manifest>
