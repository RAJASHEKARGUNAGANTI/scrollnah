<?xml version="1.0" encoding="utf-8"?>
<!-- Reel count (2x2) widget, GitHub version only (layout/widget_reels.xml). Drawn by MascotWidgets.kt;
     the tracker redraws it while Reels/Shorts are open. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_reels_description"
    android:initialLayout="@layout/widget_loading_card"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:previewLayout="@layout/widget_preview_reels"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
