<?xml version="1.0" encoding="utf-8"?>
<!-- Reel count badge (see ReelBadge.kt): a lime pill with a 2dp ink border and a hard 3dp ink shadow. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="3dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#16131F" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item
        android:bottom="3dp"
        android:right="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#C6F432" />
            <stroke
                android:width="2dp"
                android:color="#16131F" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</layer-list>
