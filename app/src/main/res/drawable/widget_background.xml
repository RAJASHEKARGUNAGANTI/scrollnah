<?xml version="1.0" encoding="utf-8"?>
<!-- Neo-brutalist widget card: lilac, 2dp ink border, hard 4dp ink shadow (no blur).
     Dark version in drawable-night. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="4dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#16131F" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item
        android:bottom="4dp"
        android:right="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#F2EEFF" />
            <stroke
                android:width="2dp"
                android:color="#16131F" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
