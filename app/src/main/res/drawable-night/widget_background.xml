<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="4dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#7C6BD6" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item
        android:bottom="4dp"
        android:right="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#26213A" />
            <stroke
                android:width="2dp"
                android:color="#F2EEFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
