<?xml version="1.0" encoding="utf-8"?>
<!-- Settings hint (HintActivity, shown as a tiny picture-in-picture window over Android's
     Settings page): the mascot and one plain line about which switch to tap. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#C6F432"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <ImageView
        android:id="@+id/hint_mascot"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/hint_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:fontFamily="@font/dm_sans"
        android:textColor="#16131F"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
