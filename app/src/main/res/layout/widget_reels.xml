<?xml version="1.0" encoding="utf-8"?>
<!-- Reel count widget (2x2, needs the tracker): "12 / reels today", a line from the mascot, and the
     mascot in today's mood. Filled in by MascotWidgets.kt (reelViews). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <TextView
        android:id="@+id/reels_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/widget_text"
        android:textSize="40sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/reels_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textAllCaps="true"
        android:letterSpacing="0.06"
        android:textColor="@color/widget_text"
        android:textSize="11sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/reels_line"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="3"
            android:textColor="@color/widget_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/mascot"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:scaleType="fitCenter" />
    </LinearLayout>
</LinearLayout>
