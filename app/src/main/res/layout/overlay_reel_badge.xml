<?xml version="1.0" encoding="utf-8"?>
<!-- The reel count badge at the top of Reels/Shorts (see ReelBadge.kt): mascot + today's count. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/reel_badge"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingTop="3dp"
    android:paddingEnd="17dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/reel_badge_mascot"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/reel_badge_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:fontFamily="@font/bricolage_grotesque"
        android:includeFontPadding="false"
        android:textColor="#16131F"
        android:textSize="20sp"
        android:textStyle="bold" />
</LinearLayout>
