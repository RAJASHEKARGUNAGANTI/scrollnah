<?xml version="1.0" encoding="utf-8"?>
<!-- The break reminder bubble (see BubbleOverlay.kt): speech bubble + mascot badge. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/bubble_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bubble_speech"
        android:fontFamily="@font/dm_sans"
        android:maxWidth="210dp"
        android:minHeight="44dp"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="17dp"
        android:paddingBottom="13dp"
        android:textColor="#16131F"
        android:textSize="15sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/bubble_mascot"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:contentDescription="Open ScrollNah" />
</LinearLayout>
