<?xml version="1.0" encoding="utf-8"?>
<!-- Play Store version. Until 2026-11-06 the optional Reels/Shorts & website tracker (an
     Accessibility service) and the reel count widget were removed here; now the Play version has
     them too. To take them out again (if Google rejects the Accessibility declaration), add inside
     <application>:
         <service android:name="com.unscroll.app.service.FeatureWatchService" tools:node="remove" />
         <receiver android:name="com.unscroll.app.widget.ReelCountWidgetReceiver" tools:node="remove" />
     and set TRACKER_AVAILABLE to false for "play" in app/build.gradle.kts. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application />
</manifest>
