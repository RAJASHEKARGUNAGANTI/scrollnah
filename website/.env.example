# Copy this file to .env.local and fill in the values (never commit .env.local).
# On Vercel, add the same names in Project > Settings > Environment Variables.

# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI=
# Database name (optional, default "scrollnah")
MONGODB_DB=scrollnah

# Gmail that sends you an email for each new message (a separate ScrollNah Gmail is best)
GMAIL_USER=
# A Gmail "App password" (Google Account > Security > 2-Step Verification > App passwords), not your normal password
GMAIL_APP_PASSWORD=
# Where new-message emails go (optional, default = GMAIL_USER)
NOTIFY_EMAIL=

# Cloudflare Turnstile (spam check on the feedback form). Leave empty while testing.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Long random text (16+ characters). Scrambles IP addresses for the spam limit and signs the newsletter's
# unsubscribe links, so it must be the SAME value here and in Vercel.
HASH_SALT=
